# Garante quebras de linha corretas por plataforma, independente do SO de quem clona.

# Arquivos do Linux PRECISAM ser LF (senão quebram: "bad interpreter ^M")
*.sh                       text eol=lf
*.py                       text eol=lf
*.desktop                  text eol=lf
*.svg                      text eol=lf
linux/packaging/robocopy-facil text eol=lf

# Arquivos do Windows ficam com CRLF
*.ps1                      text eol=crlf
*.bat                      text eol=crlf

# Binários (não normalizar)
*.exe                      binary
*.ico                      binary
*.png                      binary
*.rpm                      binary
*.deb                      binary
